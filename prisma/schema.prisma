generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================================
// COMPANY / TENANT
// ============================================================

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Company {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(200)
  code      String        @unique @db.VarChar(50)
  slug      String        @unique @db.VarChar(100)
  status    CompanyStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  settings         CompanySetting[]
  users            User[]
  roles            Role[]
  products         Product[]
  tailors          Tailor[]
  employees        Employee[]
  spks             SPK[]
  transactionTypes TransactionType[]
  transactions     Transaction[]
  workflows        Workflow[]
  activityLogs     ActivityLog[]
  scannedDocuments ScannedDocument[]
  tailorRates      TailorRate[]
  tailorBills      TailorBill[]

  @@index([status])
}

model CompanySetting {
  id        Int      @id @default(autoincrement())
  companyId Int
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, key])
  @@index([companyId])
}

// ============================================================
// AUTHENTICATION & AUTHORIZATION
// ============================================================

enum UserStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           Int        @id @default(autoincrement())
  companyId    Int?
  name         String     @db.VarChar(150)
  email        String     @unique @db.VarChar(255)
  passwordHash String     @db.VarChar(255)
  status       UserStatus @default(ACTIVE)
  roleId       Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  role    Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  activityLogs          ActivityLog[]
  scannedDocuments      ScannedDocument[]
  sessions              Session[]
  transactions          Transaction[]     @relation("TransactionCreatedBy")
  cancelledTransactions Transaction[]     @relation("TransactionCancelledBy")
  tailorBills           TailorBill[]      @relation("TailorBillCreatedBy")
  deletedSPKs           SPK[]             @relation("SPKDeletedBy")

  @@index([companyId])
  @@index([companyId, status])
  @@index([roleId])
}

model Role {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  users       User[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  id           Int @id @default(autoincrement())
  roleId       Int
  permissionId Int

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @db.VarChar(128)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================================
// MASTER DATA
// ============================================================

model Product {
  id        Int      @id @default(autoincrement())
  companyId Int?
  code      String   @db.VarChar(100)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company         Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  spkItems        SPKItem[]
  transactions    Transaction[]
  tailorRates     TailorRate[]
  tailorBillItems TailorBillItem[]

  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, isActive])
}

model Tailor {
  id        Int      @id @default(autoincrement())
  companyId Int?
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  spks         SPK[]
  transactions Transaction[]
  rates        TailorRate[]
  bills        TailorBill[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId, isActive])
}

model Employee {
  id        Int      @id @default(autoincrement())
  companyId Int?
  name      String   @db.VarChar(150)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company      Company?      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@unique([companyId, id])
  @@index([companyId, name])
  @@index([companyId, isActive])
}

// ============================================================
// SPK
// ============================================================

enum SPKStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model SPK {
  id          Int       @id @default(autoincrement())
  companyId   Int?
  spkNumber   String    @db.VarChar(100)
  tailorId    Int
  status      SPKStatus @default(ACTIVE)
  deletedAt   DateTime?
  deletedById Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tailor    Tailor   @relation(fields: [tailorId], references: [id], onDelete: Restrict)
  deletedBy User?    @relation("SPKDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  items           SPKItem[]
  transactions    Transaction[]
  tailorBillItems TailorBillItem[]

  @@unique([companyId, spkNumber])
  @@unique([companyId, id])
  @@index([companyId, tailorId])
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@index([deletedById])
}

model SPKItem {
  id        Int @id @default(autoincrement())
  spkId     Int
  productId Int
  quantity  Int

  spk     SPK     @relation(fields: [spkId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spkId, productId])
  @@index([spkId])
  @@index([productId])
}

// ============================================================
// TRANSACTION
// ============================================================

enum TransactionStatus {
  ACTIVE
  CANCELLED
}

model TransactionType {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  code        String   @db.VarChar(100)
  name        String   @db.VarChar(150)
  description String?  @db.Text
  sequence    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  transactions  Transaction[]
  workflowSteps WorkflowStep[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId, sequence])
  @@index([companyId, isActive])
}

model Transaction {
  id                 Int               @id @default(autoincrement())
  companyId          Int?
  transactionNumber  String            @db.VarChar(100)
  spkId              Int
  transactionTypeId  Int
  productId          Int
  tailorId           Int
  employeeId         Int
  quantity           Int
  createdById        Int?
  status             TransactionStatus @default(ACTIVE)
  cancelledAt        DateTime?
  cancelledById      Int?
  cancellationReason String?           @db.Text
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company          Company?          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scannedDocuments ScannedDocument[]

  createdBy       User?           @relation("TransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy     User?           @relation("TransactionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  spk             SPK             @relation(fields: [spkId], references: [id], onDelete: Restrict)
  tailor          Tailor          @relation(fields: [tailorId], references: [id], onDelete: Restrict)
  transactionType TransactionType @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)

  @@unique([companyId, transactionNumber])
  @@unique([companyId, id])
  @@index([companyId, spkId])
  @@index([companyId, transactionTypeId])
  @@index([companyId, productId])
  @@index([companyId, tailorId])
  @@index([companyId, employeeId])
  @@index([companyId, status])
  @@index([companyId, createdAt])
  @@index([createdById])
  @@index([cancelledById])
}

// ============================================================
// WORKFLOW
// ============================================================

model Workflow {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  name        String   @db.VarChar(150)
  code        String   @db.VarChar(100)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company?       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rules   WorkflowRule[]
  steps   WorkflowStep[]

  @@unique([companyId, name])
  @@unique([companyId, code])
  @@unique([companyId, id])
  @@index([companyId, isActive])
}

model WorkflowStep {
  id                Int      @id @default(autoincrement())
  workflowId        Int
  transactionTypeId Int
  sequence          Int
  isRequired        Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  transactionType TransactionType @relation(fields: [transactionTypeId], references: [id], onDelete: Restrict)
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, sequence])
  @@unique([workflowId, transactionTypeId])
  @@index([transactionTypeId])
  @@index([isActive])
}

model WorkflowRule {
  id          Int      @id @default(autoincrement())
  workflowId  Int
  name        String   @db.VarChar(150)
  description String?  @db.Text
  condition   String   @db.Text
  action      String   @db.Text
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([priority])
  @@index([isActive])
}

// ============================================================
// ACTIVITY LOG
// ============================================================

model ActivityLog {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  userId      Int?
  action      String   @db.VarChar(100)
  entityType  String   @db.VarChar(100)
  entityId    String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, userId])
  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
}

// ============================================================
// SCANNER
// ============================================================

enum ScanStatus {
  PENDING
  VALID
  INVALID
  PROCESSED
  DUPLICATE
  REVIEW_REQUIRED
}

enum ScanSource {
  QR
  BARCODE
  OCR
  MANUAL
}

model ScannedDocument {
  id                Int        @id @default(autoincrement())
  companyId         Int?
  documentNumber    String     @db.VarChar(100)
  documentType      String?    @db.VarChar(100)
  source            ScanSource
  status            ScanStatus @default(PENDING)
  imageUrl          String?    @db.VarChar(500)
  rawText           String?    @db.Text
  extractedData     String?    @db.LongText
  normalizedData    String?    @db.LongText
  validationMessage String?    @db.Text
  transactionId     Int?
  scannedByUserId   Int?
  scannedAt         DateTime   @default(now())
  processedAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  scannedBy   User?        @relation(fields: [scannedByUserId], references: [id], onDelete: SetNull)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@unique([companyId, documentNumber])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([companyId, transactionId])
  @@index([companyId, scannedByUserId])
  @@index([companyId, scannedAt])
}

// ============================================================
// SEQUENCES
// ============================================================

model TransactionSequence {
  id        Int      @id @default(autoincrement())
  date      String   @unique @db.VarChar(8)
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model TailorBillSequence {
  date      String   @id @db.VarChar(8)
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// TAILOR RATE
// ============================================================

model TailorRate {
  id            Int       @id @default(autoincrement())
  companyId     Int?
  tailorId      Int
  productId     Int
  rate          Decimal   @db.Decimal(15, 2)
  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tailor  Tailor   @relation(fields: [tailorId], references: [id], onDelete: Restrict)
  product Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([companyId, tailorId, productId])
  @@index([companyId, isActive])
  @@index([companyId, effectiveFrom])
}

// ============================================================
// TAILOR BILLING
// ============================================================

enum TailorBillStatus {
  DRAFT
  SUBMITTED
  PAID
  CANCELLED
}

model TailorBill {
  id          Int              @id @default(autoincrement())
  companyId   Int?
  billNumber  String           @db.VarChar(100)
  tailorId    Int
  status      TailorBillStatus @default(DRAFT)
  subtotal    Decimal          @db.Decimal(15, 2)
  totalAmount Decimal          @db.Decimal(15, 2)
  notes       String?          @db.Text
  createdById Int?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  company Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  tailor  Tailor           @relation(fields: [tailorId], references: [id], onDelete: Restrict)
  items   TailorBillItem[]

  createdBy User? @relation("TailorBillCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, billNumber])
  @@unique([companyId, id])
  @@index([companyId, tailorId])
  @@index([companyId, status])
  @@index([companyId, createdById])
  @@index([companyId, createdAt])
}

model TailorBillItem {
  id        Int     @id @default(autoincrement())
  billId    Int
  spkId     Int
  productId Int
  quantity  Decimal @db.Decimal(15, 2)
  rate      Decimal @db.Decimal(15, 2)
  amount    Decimal @db.Decimal(15, 2)

  bill    TailorBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  spk     SPK        @relation(fields: [spkId], references: [id], onDelete: Restrict)
  product Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([billId])
  @@index([spkId])
  @@index([productId])
}
